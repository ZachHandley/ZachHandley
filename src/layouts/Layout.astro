---
import "../styles/global.css";
import SiteMetadata from "../components/global/SiteMetadata.astro";
export interface Props {
  title: string;
  description: string;
  lockViewport?: boolean;
}

const { title, description, lockViewport = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteMetadata title={title} description={description} />
    <title>{title}</title>
  </head>
  <body class={lockViewport ? "route-locked" : undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-accent-fg"
    >
      skip to main content
    </a>
    <slot />
  </body>
</html>
<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: system-ui, sans-serif;
  }

  /* Routes that own the full viewport (3D scenes, immersive views) opt in. */
  body.route-locked {
    height: 100%;
    overflow: hidden;
  }

  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
